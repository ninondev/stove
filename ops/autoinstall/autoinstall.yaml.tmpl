#cloud-config
# SPDX-License-Identifier: GPL-3.0-only
# WARNING: unattended installation erases {{TARGET_DISK}}.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: UTC
  source:
    id: ubuntu-desktop
    search_drivers: false
  refresh-installer:
    update: false
  codecs:
    install: false
  drivers:
    install: false
  oem:
    install: false
  apt:
    fallback: offline-install
    geoip: false
  network:
    version: 2
    ethernets:
      offline:
        match:
          name: "*"
        dhcp4: false
        dhcp6: false
        link-local: []
  storage:
    layout:
      name: direct
      match:
        path: "{{TARGET_DISK}}"
  identity:
    realname: "Stove Demo Admin"
    username: "demo-admin"
    hostname: "stove-demo"
    password: "{{PASSWORD_HASH}}"
  ssh:
    install-server: false
  late-commands:
    - |
      set -eu
      SRC=""
      for d in /cdrom /run/live/medium /media/*/* /mnt; do
        if [ -f "$d/stove/stove-src.tar.gz" ]; then SRC="$d/stove"; break; fi
      done
      [ -n "$SRC" ] || { echo 'Stove payload not found'; exit 1; }
      echo '{{PAYLOAD_SHA256}}  '"$SRC/stove-src.tar.gz" | sha256sum --check --status
      mkdir -p /target/opt/stove /target/var/lib/stove-firstboot
      tar -xzf "$SRC/stove-src.tar.gz" -C /target/opt/stove --no-same-owner
      cp /target/opt/stove/ops/autoinstall/stove-firstboot.service /target/etc/systemd/system/
      touch /target/var/lib/stove-firstboot/pending
      printf '\nGRUB_CMDLINE_LINUX="console=tty0 console=ttyS0,115200"\n' >> /target/etc/default/grub
    - curtin in-target --target=/target -- update-grub
    - curtin in-target --target=/target -- systemctl enable stove-firstboot.service
  shutdown: poweroff
